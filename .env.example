# ==============================================================
# ZENFI - Plantilla de configuración
# INSTRUCCIONES PARA OTRO COMPUTADOR:
# 1. Copia este archivo como: src/main/resources/application.properties
# 2. Rellena cada valor con tus credenciales reales
# 3. NUNCA subas ese archivo a GitHub
# ==============================================================

spring.application.name=appfinanciera

# --- Claude AI ---
# Obtén tu clave en: https://console.anthropic.com
anthropic.api.key=sk-ant-api03-TU_CLAVE_AQUI

server.port=8080

# --- Base de datos MySQL ---
# Asegúrate de tener MySQL corriendo y la base de datos creada (usa appfinancieraBD.sql)
spring.datasource.url=jdbc:mysql://localhost:3306/appfinanciera2?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota
spring.datasource.username=root
spring.datasource.password=TU_PASSWORD_MYSQL

spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# --- Thymeleaf ---
spring.thymeleaf.cache=false
spring.thymeleaf.prefix=classpath:/templates/
spring.thymeleaf.suffix=.html

server.servlet.context-path=/
app.base-url=http://localhost:8080

logging.level.org.springframework.security=INFO
logging.level.org.hibernate.SQL=INFO

# --- Correo Gmail ---
# Requiere una "App Password" de Google (no tu contraseña normal)
# Actívala en: Cuenta Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicación
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=TU_CORREO@gmail.com
spring.mail.password=TU_APP_PASSWORD_16_DIGITOS
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true

# --- Google OAuth2 (Login con Google) ---
# Obtén las claves en: https://console.cloud.google.com > APIs > Credenciales
# URI de redireccion autorizada: http://localhost:8080/login/oauth2/code/google
spring.security.oauth2.client.registration.google.client-id=TU_CLIENT_ID.apps.googleusercontent.com
spring.security.oauth2.client.registration.google.client-secret=GOCSPX-TU_CLIENT_SECRET
spring.security.oauth2.client.registration.google.scope=openid,email,profile
spring.security.oauth2.client.registration.google.redirect-uri={baseUrl}/login/oauth2/code/{registrationId}
spring.security.oauth2.client.registration.google.client-name=Google
